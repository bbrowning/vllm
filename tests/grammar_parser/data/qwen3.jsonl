{"id": "qwen3-think-then-tool-001", "description": "Reasoning in <think> block then XML tool call", "source": "hand-crafted", "vocab": {"<think>": 50, "</think>": 51, "<tool_call>": 60, "</tool_call>": 61}, "tokens": [[50, "<think>"], [100, "Let"], [101, " me"], [102, " check"], [103, " the"], [104, " file."], [51, "</think>"], [60, "<tool_call>"], [110, "\n<function=read>"], [111, "\n<parameter=filePath>"], [112, "/tmp/test.txt"], [113, "</parameter>"], [114, "\n</function>"], [115, "\n"], [61, "</tool_call>"]], "expected": {"reasoning": "Let me check the file.", "content": null, "tool_calls": [{"name": "read", "arguments": {"filePath": "/tmp/test.txt"}}]}}
